{
  "name": "wms",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "dev": "pnpm --filter api start:dev",

    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:seed": "node packages/db/seed.js",

    "api:build": "pnpm --filter api build",
    "api:start": "pnpm --filter api start:prod"
  },
  "devDependencies": {
    "prisma": "6.19.2",
    "typescript": "^5.9.3",
    "eslint": "^10.0.2",
    "prettier": "^3.8.1"
  },
  "dependencies": {
    "@prisma/client": "6.19.2"
  }
}